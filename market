<script>
    const rulesBlock = document.getElementById('rules');
    const btn = document.getElementById('toggleBtn');

    function toggleRules() {
        const isVisible = rulesBlock.classList.toggle('visible');
        btn.classList.toggle('open', isVisible);
        btn.textContent = isVisible ? '📕 Скрыть правила' : '📖 Открыть правила';
        if (isVisible) {
            setTimeout(() => rulesBlock.scrollIntoView({ behavior: 'smooth' }), 100);
        }
    }
</script>
