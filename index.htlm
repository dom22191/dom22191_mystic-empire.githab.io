<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MysticEmpire — Minecraft сервер</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        font-family: 'Segoe UI', Arial, sans-serif;
        background: linear-gradient(160deg, #1a2332 0%, #10161f 100%);
        color: #e8eef5;
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* ---------- Падающие частицы ---------- */
    .particles {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }
    .particle {
        position: absolute;
        top: -20px;
        border-radius: 50%;
        animation: fall linear infinite;
    }
    @keyframes fall {
        to { transform: translateY(110vh) rotate(360deg); }
    }

    .container { max-width: 1000px; margin: 0 auto; padding: 60px 16px; position: relative; z-index: 1; }

    /* ---------- Шапка ---------- */
    .logo {
        text-align: center;
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: 2px;
        color: #ffd54a;
        text-shadow: 3px 3px 0 #3d2f00, 0 0 40px rgba(255,213,74,.35);
        animation: glow 3s ease-in-out infinite;
    }
    @keyframes glow {
        0%, 100% { text-shadow: 3px 3px 0 #3d2f00, 0 0 25px rgba(255,213,74,.25); }
        50%      { text-shadow: 3px 3px 0 #3d2f00, 0 0 55px rgba(255,213,74,.55); }
    }

    .tagline {
        text-align: center;
        color: #9fb3c8;
        font-size: 1.15rem;
        margin: 14px 0 40px;
    }

    /* ---------- Плашка онлайн ---------- */
    .online-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-bottom: 44px;
        flex-wrap: wrap;
    }
    .online-badge {
        background: rgba(126,231,135,.12);
        border: 1px solid rgba(126,231,135,.4);
        color: #7ee787;
        padding: 8px 20px;
        border-radius: 30px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pulse-dot {
        width: 10px;
        height: 10px;
        background: #7ee787;
        border-radius: 50%;
        animation: pulse 1.5s ease-in-out infinite;
    }
    @keyframes pulse {
        0%, 100% { transform: scale(1);     box-shadow: 0 0 0 0 rgba(126,231,135,.5); }
        50%      { transform: scale(1.25);  box-shadow: 0 0 0 8px rgba(126,231,135,0); }
    }

    /* ---------- Копирование IP ---------- */
    .ip-box {
        background: rgba(255,255,255,.06);
        border: 2px dashed rgba(255,213,74,.5);
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        margin-bottom: 50px;
        cursor: pointer;
        transition: transform .2s, background .2s;
    }
    .ip-box:hover { background: rgba(255,213,74,.08); transform: translateY(-3px); }
    .ip-box .ip { font-size: 1.7rem; font-weight: 800; color: #ffd54a; font-family: 'Consolas', monospace; }
    .ip-box .hint { color: #9fb3c8; margin-top: 6px; font-size: .95rem; }

    .toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(80px);
        background: #2e7d32;
        color: #fff;
        padding: 12px 28px;
        border-radius: 30px;
        font-weight: 700;
        opacity: 0;
        transition: transform .3s, opacity .3s;
        z-index: 200;
    }
    .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

    /* ---------- Кнопки-страницы ---------- */
    .nav-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 60px;
    }
    .nav-card {
        background: rgba(255,255,255,.05);
        border: 2px solid rgba(255,255,255,.1);
        border-radius: 16px;
        padding: 30px 20px;
        text-align: center;
        text-decoration: none;
        color: #e8eef5;
        transition: transform .2s, border-color .2s, box-shadow .2s;
    }
    .nav-card:hover {
        transform: translateY(-6px);
        border-color: #ffd54a;
        box-shadow: 0 12px 30px rgba(0,0,0,.5);
    }
    .nav-card .icon { font-size: 2.4rem; margin-bottom: 12px; }
    .nav-card h3 { color: #ffd54a; margin-bottom: 8px; }
    .nav-card p { color: #9fb3c8; font-size: .92rem; }

    /* ---------- Факты о сервере ---------- */
    .features h2 {
        color: #ffd54a;
        font-size: 1.6rem;
        margin-bottom: 24px;
        text-align: center;
    }
    .feature-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
    }
    .feature-item {
        background: rgba(255,255,255,.05);
        border-left: 4px solid #4fc3f7;
        border-radius: 10px;
        padding: 18px 20px;
        opacity: 0;
        transform: translateY(24px);
        transition: opacity .6s, transform .6s;
    }
    .feature-item.visible { opacity: 1; transform: translateY(0); }
    .feature-item b { color: #ffd54a; }

    footer {
        text-align: center;
        color: #6b7f94;
        padding: 30px 0 20px;
        font-size: .9rem;
    }

    @media (max-width: 600px) {
        .logo { font-size: 2rem; }
        .ip-box .ip { font-size: 1.2rem; }
    }
</style>
</head>
<body>

    <div class="particles" id="particles"></div>

    <div class="container">
        <h1 class="logo">⚔️ MysticEmpire</h1>
        <p class="tagline">Магический мир выживания, кланов и приключений</p>

        <div class="online-bar">
            <div class="online-badge">
                <span class="pulse-dot"></span>
                Онлайн: <span id="onlineCount">…</span>
            </div>
            <div class="online-badge" style="border-color: rgba(79,195,247,.4); color:#4fc3f7; background: rgba(79,195,247,.1);">
                🕒 Вайп: никогда. Мир живёт с 2024 года
            </div>
        </div>

        <div class="ip-box" onclick="copyIP()" title="Нажми, чтобы скопировать">
            <div class="ip" id="ipText">play.mysticempire.ru</div>
            <div class="hint">📋 Нажми на адрес — он скопируется сам</div>
        </div>

        <div class="nav-cards">
            <a class="nav-card" href="rules.html">
                <div class="icon">📜</div>
                <h3>Правила</h3>
                <p>Прочитай перед игрой — незнание не освобождает от ответственности</p>
            </a>
            <a class="nav-card" href="donate.html">
                <div class="icon">✨</div>
                <h3>Донат</h3>
                <p>Привилегии от Странника до Императора — поддержи сервер</p>
            </a>
        </div>

        <div class="features">
            <h2>Почему у нас круто</h2>
            <div class="feature-list">
                <div class="feature-item"><b>🐉 Боссы и данжи.</b> Каждую неделю новый ивент с уникальной наградой.</div>
                <div class="feature-item"><b>🏰 Кланы и войны.</b> Захватывай территории, строй крепости, воюй за господство.</div>
                <div class="feature-item"><b>⚖️ Честная экономика.</b> Никаких покупных преимуществ в PvP — только скилл.</div>
                <div class="feature-item"><b>🛡️ Живая модерация.</b> Жалобы разбираются в Discord в течение суток.</div>
                <div class="feature-item"><b>🌍 Донат-мир.</b> Отдельный мир с ресурсами для владельцев привилегий.</div>
                <div class="feature-item"><b>🎉 Ежедневные квесты.</b> Заходи каждый день — получай награды и прокачивайся.</div>
            </div>
        </div>

        <footer>© MysticEmpire · Мы не аффилированы с Mojang AB</footer>
    </div>

    <div class="toast" id="toast">✅ IP скопирован!</div>

<script>
    // ---------- Падающие частицы ----------
    const particles = document.getElementById('particles');
    const colors = ['#ffd54a', '#4fc3f7', '#7ee787', '#ce93d8'];
    for (let i = 0; i < 40; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        const size = Math.random() * 6 + 3;
        p.style.width = size + 'px';
        p.style.height = size + 'px';
        p.style.left = Math.random() * 100 + '%';
        p.style.background = colors[Math.floor(Math.random() * colors.length)];
        p.style.opacity = Math.random() * 0.5 + 0.15;
        p.style.animationDuration = (Math.random() * 12 + 8) + 's';
        p.style.animationDelay = '-' + (Math.random() * 15) + 's';
        particles.appendChild(p);
    }

    // ---------- Копирование IP ----------
    function copyIP() {
        const ip = document.getElementById('ipText').textContent;
        navigator.clipboard.writeText(ip).then(showToast).catch(() => {
            // запасной вариант для старых браузеров
            const ta = document.createElement('textarea');
            ta.value = ip;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
            showToast();
        });
    }
    function showToast() {
        const t = document.getElementById('toast');
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2000);
    }

    // ---------- Живой счётчик онлайна ----------
    let online = 47;
    const onlineEl = document.getElementById('onlineCount');
    onlineEl.textContent = online;
    setInterval(() => {
        const change = Math.floor(Math.random() * 5) - 2; // -2..+2
        online = Math.max(12, Math.min(120, online + change));
        onlineEl.textContent = online;
    }, 4000);

    // ---------- Плавное появление фич при прокрутке ----------
    const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) e.target.classList.add('visible');
        });
    }, { threshold: 0.2 });
    document.querySelectorAll('.feature-item').forEach((el, i) => {
        el.style.transitionDelay = (i * 0.08) + 's';
        observer.observe(el);
    });
</script>
</body>
</html>
